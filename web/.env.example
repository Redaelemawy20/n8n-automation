# Copy to .env.local and adjust. All are optional.

# Where n8n runs. The webhook URLs below default to <N8N_BASE_URL>/webhook/<path>.
N8N_BASE_URL=http://localhost:5678

# Override a single workflow's webhook URL
# N8N_ORCHESTRATOR_WEBHOOK_URL=http://localhost:5678/webhook/orchestrator
# N8N_TTS_WEBHOOK_URL=http://localhost:5678/webhook/tts
